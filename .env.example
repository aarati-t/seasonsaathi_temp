# Copy to .env and fill in. Never commit .env.

# --- Gemini access: vertex (primary) | apikey (AI Studio fallback)
GENAI_MODE=vertex
# Must agree with GENAI_MODE (ADK reads this): TRUE for vertex, FALSE for apikey
GOOGLE_GENAI_USE_VERTEXAI=TRUE
# Vertex mode (ADC locally: gcloud auth application-default login)
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global           # Vertex endpoint; current Gemini models are served on global
CLOUD_RUN_REGION=us-central1           # Cloud Run region (deploy.sh); not a Vertex setting
# apikey mode (AI Studio key)
GOOGLE_API_KEY=

# --- Earth Engine (scripts/ee_export.py); defaults to GOOGLE_CLOUD_PROJECT
EE_PROJECT=your-ee-registered-project-id

# --- Models (never hard-coded)
GEMINI_MODEL=gemini-3.5-flash     # 3.8-flash had no quota on our project (429); 3.5 answers in ~1-3 s
# Dev cost saver: GEMINI_MODEL=gemini-3.5-flash-lite while building UI/KPIs (cheaper per token);
# switch back to gemini-3.5-flash before the demo. Verify the name first: python scripts/check_vertex.py
EMBED_MODEL=gemini-embedding-001

# --- Backends
DATA_BACKEND=postgres            # postgres | bigquery | csv (emergency read-only fallback)
DATABASE_URL=postgresql:///seasonsaathi        # local socket, your OS user's role
TEST_DATABASE_URL=postgresql:///seasonsaathi_test  # pytest; name must end in _test (it is truncated)
BQ_DATASET=seasonsaathi
BQ_LOCATION=asia-south1          # dataset region (BigQuery queries/loads)
VECTOR_MODE=python               # python | bq
PMODEL_MODE=off                  # off | sklearn | bqml
STORAGE_BACKEND=local            # local | gcs
GCS_BUCKET=
ALERTS_MODE=local                # local | pubsub
PUBSUB_TOPIC=stress-alerts
ORCHESTRATOR=adk                 # adk | plain

# --- Keep Vertex usage low, cache, fall back (core/settings.py)
LLM_CACHE=disk                   # disk | off: cache every Gemini response by request hash; repeats cost nothing
LLM_CACHE_DIR=.cache/llm         # on Cloud Run use /tmp/llm-cache (lost on restart)
LLM_OFFLINE=false                # true: never call Gemini; last good result, else rule result (LOW)
# Dev cost saver: LLM_OFFLINE=true for layout/UI work (screens fill from cached or rule results, Rs 0)
GEMINI_THINKING=low              # low | off | default: model thinking (latency and cost)
LLM_TIMEOUT_S=30                 # per-call HTTP timeout (plain engine)
LLM_MAX_RETRIES=3                # retries on 429/503 with exponential backoff
ENGINE_FALLBACK=on               # ADK error / timeout / bad schema -> plain engine
ENGINE_TIMEOUT_S=20              # ADK time limit (SPEC section 3)
VERIFIER_AGENT=on                # off saves 1 Gemini call per run; the code verifier always runs
MAX_REGENERATIONS=1              # assessor re-runs after a verifier FAIL, then downgrade to LOW
RESULT_CACHE=on                  # all engines failed -> reuse last PASS result from decision_log

# --- Cloud Run warm instance (deploy-time only, not read from .env)
# Default min-instances=0: no cost when idle, first request after a pause waits for a cold start.
# Demo day: gcloud run services update seasonsaathi --region $REGION --min-instances 1   (no rebuild)
# After demo: gcloud run services update seasonsaathi --region $REGION --min-instances 0
